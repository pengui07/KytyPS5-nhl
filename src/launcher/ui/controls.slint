// Controls page: the PS5 controls mapped to keyboard keys / mouse buttons and to gamepad buttons.
// The Qt launcher's Controls dialog, as a page: two tabs, click a binding then press, right-click clears.

import { ScrollView } from "std-widgets.slint";
import { Theme, Selector, AppButton, AppCheckBox, AppSlider } from "common.slint";

// One row: a PS5 control and the binding it shows.
export struct ControlRow {
    id: string,
    label: string,
    binding: string,     // as shown ("None" when unbound)
    section: string,
    section-start: bool, // first row of its section: the section title goes above it
}

// State of the page (the C++ side fills it when the page opens).
export global Controls {
    in-out property <int> tab: 0; // 0 = Gamepad, 1 = Keyboard & Mouse
    in property <[ControlRow]> gamepad-rows;
    in property <[ControlRow]> keyboard-rows;
    in property <[string]> pad-sources; // labels of every gamepad button / trigger, table order
    in property <bool> listening;       // a capture is running: the overlay is up
    in property <string> capture-id;    // the row being captured
    in property <string> capture-label; // its control label, for the overlay title
    in property <string> capture-message;
    in property <string> status; // "Connected: Controller 1" / "No controller connected"
    in-out property <string> notice;
    in-out property <float> sensitivity: 1.0;
    in property <string> sensitivity-text: "1.0×";
    in-out property <int> skin-index: 0;
    in-out property <bool> show-cursor: true;

    callback opened();
    callback begin-capture(string, bool); // control id, gamepad tab
    callback clear-binding(string, bool);
    callback pick-source(int); // index in pad-sources
    callback restore-defaults(bool); // gamepad tab
    callback sensitivity-edited(float);
    callback cancel-capture();
    callback save();
    callback cancel();
    callback close();
}

// One tab of the strip; the active one has an accent underline.
component TabHeader inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    width: 140px;
    height: 32px;
    border-radius: 0px;
    background: root.active ? #ffffff14 : touch.has-hover ? #ffffff0a : transparent;
    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        color: root.active ? Theme.text : Theme.muted;
        font-size: 13px;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        visible: root.active;
        y: parent.height - 2px;
        height: 2px;
        width: parent.width - 24px;
        x: 12px;
        background: Theme.accent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Label on the left, the binding button on the right. Click binds, right-click clears (upstream's behaviour).
component BindingRow inherits Rectangle {
    in property <ControlRow> entry;
    in property <bool> pad;
    height: 30px;
    Text {
        x: 2px;
        width: max(0px, parent.width - 214px);
        height: parent.height;
        text: root.entry.label;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: parent.width - 200px;
        y: 2px;
        width: 196px;
        height: 26px;
        border-radius: 0px;
        border-width: 1px;
        border-color: capturing ? Theme.accent : bind.has-hover ? Theme.accent : Theme.card-border;
        background: bind.has-hover ? #1d212a : #07090c;
        Text {
            x: 8px;
            width: parent.width - 16px;
            height: parent.height;
            text: capturing ? "Press…" : root.entry.binding;
            color: capturing ? Theme.accent : root.entry.binding == "None" ? Theme.faint : Theme.text;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        bind := TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    if (event.button == PointerEventButton.right) {
                        Controls.clear-binding(root.entry.id, root.pad);
                    } else if (event.button == PointerEventButton.left) {
                        Controls.begin-capture(root.entry.id, root.pad);
                    }
                }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #ffffff0d;
    }
    property <bool> capturing: Controls.listening && Controls.capture-id == root.entry.id;
}

// Section title + rows of one tab, in the order the C++ side sends them.
component TabRows inherits VerticalLayout {
    in property <[ControlRow]> rows;
    in property <bool> pad;
    alignment: start;
    for row in root.rows: VerticalLayout {
        if row.section-start: Text {
            height: 30px;
            text: row.section;
            color: Theme.muted;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: bottom;
        }
        BindingRow { entry: row; pad: root.pad; }
    }
}

export component ControlsPage inherits Rectangle {
    callback close();
    background: Theme.bg;

    // Clicks that miss the page's own controls stop here instead of reaching the library under it.
    TouchArea { }

    VerticalLayout {
        padding: 18px;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 10px;

        // Title and the way back to the library.
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "Controls";
                color: Theme.text;
                font-size: 24px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 58px;
                    height: 40px;
                    border-radius: 0px;
                    background: back-touch.pressed ? #2b3345 : back-touch.has-hover ? #2b3345 : #1d212a;
                    animate background { duration: 100ms; }
                    Image {
                        x: 9px;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("icons/chevron-thin-left.svg");
                        colorize: Theme.muted;
                        width: 9px;
                        height: 20px;
                    }
                    Image {
                        x: 21px;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("icons/library.svg");
                        colorize: Theme.text;
                        width: 30px;
                        height: 30px;
                    }
                    back-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close(); }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 4px;
            TabHeader { text: "Gamepad"; active: Controls.tab == 0; clicked => { Controls.tab = 0; } }
            TabHeader { text: "Keyboard & Mouse"; active: Controls.tab == 1; clicked => { Controls.tab = 1; } }
            Rectangle { horizontal-stretch: 1; }
        }

        // The tab's own list.
        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            if Controls.tab == 0: VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                spacing: 6px;

                Text {
                    text: "Choose which button on your gamepad triggers each PS5 control. Click a binding, then press the button or trigger you want to use.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: Controls.status;
                    color: Theme.text;
                    font-size: 12px;
                }
                Text {
                    text: "Older/fork builds may exit with 'Invalid input mapping' when a Pad: binding is set.";
                    color: Theme.faint;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                ScrollView {
                    vertical-stretch: 1;
                    TabRows { rows: Controls.gamepad-rows; pad: true; }
                }
            }

            if Controls.tab == 1: VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                spacing: 6px;

                Text {
                    text: "Choose which keyboard key or mouse button triggers each PS5 control. Click a binding, then press the key or mouse button.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                ScrollView {
                    vertical-stretch: 1;
                    TabRows { rows: Controls.keyboard-rows; pad: false; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "Mouse sensitivity";
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        width: 130px;
                    }
                    VerticalLayout {
                        alignment: center;
                        AppSlider {
                            width: 220px;
                            minimum: 0.1;
                            maximum: 5.0;
                            step: 0.1;
                            value <=> Controls.sensitivity;
                            changed(value) => { Controls.sensitivity-edited(value); }
                        }
                    }
                    Text {
                        text: Controls.sensitivity-text;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        width: 48px;
                    }
                    Text {
                        text: "F7 in-game toggles mouse movement on the right stick.";
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }
        }

        // The emulated touch pad: shared by both tabs, as in upstream.
        Rectangle {
            height: 56px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            border-radius: 0px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Emulated touch pad";
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Particle skin";
                        color: Theme.muted;
                        font-size: 12px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Selector {
                        width: 150px;
                        model: ["Classic", "Blue neon", "Monochrome", "Crimson", "Red/Blue"];
                        current-index <=> Controls.skin-index;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    AppCheckBox {
                        text: "Show hand cursor and trail";
                        checked <=> Controls.show-cursor;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Toggle with the touch pad mode key (F6); draw with left mouse / Cross.";
                        color: Theme.muted;
                        font-size: 11px;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Text {
                text: Controls.notice != "" ? Controls.notice : "Tip: right-click a binding to unmap it.";
                color: Controls.notice != "" ? Theme.danger : Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                AppButton {
                    text: "Restore Defaults";
                    clicked => { Controls.restore-defaults(Controls.tab == 0); }
                }
            }
            VerticalLayout {
                alignment: center;
                AppButton {
                    text: "Cancel";
                    clicked => { Controls.cancel(); }
                }
            }
            VerticalLayout {
                alignment: center;
                AppButton {
                    text: "Save";
                    primary: true;
                    clicked => { Controls.save(); }
                }
            }
        }
    }

    // Capture: the page keeps its input, the overlay only says what to press.
    if Controls.listening: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #000000a6;
        TouchArea { }
        Rectangle {
            width: min(460px, root.width - 48px);
            height: capture-box.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 3;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            border-radius: 0px;
            capture-box := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Set binding — " + Controls.capture-label;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: Controls.capture-message;
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if Controls.tab == 0: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Or pick one from the list:";
                        color: Theme.muted;
                        font-size: 12px;
                    }
                    Selector {
                        model: Controls.pad-sources;
                        selected => { Controls.pick-source(self.current-index); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    AppButton {
                        text: "Cancel";
                        clicked => { Controls.cancel-capture(); }
                    }
                }
            }
        }
    }
}
