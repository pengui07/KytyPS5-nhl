// Trophies page: progress of every game that has trophies.

import { ScrollView } from "std-widgets.slint";
import { Theme, AppButton, AppCheckBox } from "common.slint";

export struct TrophyGame {
    name: string,
    serial: string,
    icon: image,
    percent: int,
    earned: int,
    total: int,
    platinum: int, // earned per grade
    gold: int,
    silver: int,
    bronze: int,
}

export struct TrophyItem {
    name: string,
    detail: string,
    reward: string,  // package reward text, empty when it has none
    icon: image,
    grade: int,      // 1 platinum .. 4 bronze
    earned: bool,
    earned-at: string,
    hidden: bool,
}

// State of the Trophies page (the C++ side fills it when the page opens).
export global Trophies {
    // One game's trophies; open-game(i) fills these for row i of `games`.
    in-out property <bool> detail-open;
    in property <TrophyGame> detail-game;
    in property <[TrophyItem]> items;
    callback open-game(int);
    in property <[TrophyGame]> games;
    in property <int> earned;   // all games together
    in property <int> platinum;
    in property <int> gold;
    in property <int> silver;
    in property <int> bronze;
    in property <bool> loading;
    // Where unlocks are read from, shown in the empty state (set when the page opens).
    in property <string> run-dir;
    callback opened();
}

// A trophy cup in its grade's colour with a count beside it.
component GradeCount inherits HorizontalLayout {
    in property <color> cup;
    in property <int> count;
    in property <length> size: 20px;
    spacing: 4px;
    VerticalLayout {
        alignment: center;
        Image {
            source: @image-url("icons/cup.svg");
            colorize: root.cup;
            width: root.size;
            height: root.size;
        }
    }
    Text {
        text: root.count;
        color: Theme.text;
        font-size: root.size * 0.8;
        vertical-alignment: center;
        min-width: root.size * 0.8;
    }
}

global Cups {
    out property <color> platinum: #7cc4ff;
    out property <color> gold: #e8b931;
    out property <color> silver: #b8bec7;
    out property <color> bronze: #c27c4a;
    public pure function of(grade: int) -> color {
        return grade == 1 ? platinum : grade == 2 ? gold : grade == 3 ? silver : bronze;
    }
}

component TrophyItemRow inherits Rectangle {
    in property <TrophyItem> item;
    in property <bool> reveal: false; // "Reveal hidden trophies": show hidden, unearned names/details
    height: 76px;
    HorizontalLayout {
        padding: 8px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        Rectangle {
            width: 60px;
            height: 60px;
            background: #07090c;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.item.icon;
                image-fit: cover;
                opacity: root.item.earned ? 1 : 0.35;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.item.hidden && !root.item.earned && !root.reveal ? "Hidden trophy" : root.item.name;
                color: root.item.earned ? Theme.text : Theme.muted;
                font-size: 15px;
                overflow: elide;
            }
            Text {
                text: root.item.hidden && !root.item.earned && !root.reveal ? "" : root.item.detail;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.item.earned ? (root.item.earned-at == "" ? "Earned" : root.item.earned-at) : "Locked";
                color: root.item.earned ? Theme.text : Theme.faint;
                font-size: 12px;
                horizontal-alignment: right;
            }
        }
        HorizontalLayout {
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("icons/cup.svg");
                    colorize: root.item.earned ? Cups.of(root.item.grade) : Cups.of(root.item.grade).with-alpha(0.35);
                    width: 26px;
                    height: 26px;
                }
            }
            // Compact reward text of the package (the format has no points value).
            if root.item.reward != "" && !(root.item.hidden && !root.item.earned && !root.reveal): Text {
                text: root.item.reward;
                color: Theme.faint;
                font-size: 10px;
                vertical-alignment: center;
                overflow: elide;
                max-width: 120px;
            }
        }
    }
}

component TrophyGameRow inherits Rectangle {
    in property <TrophyGame> game;
    in property <bool> selected;
    callback clicked();
    height: 112px;
    background: root.selected ? #ffffff1f : touch.has-hover ? Theme.row-hover : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.accent.with-alpha(0.6);
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding: 12px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        Rectangle {
            width: 88px;
            height: 88px;
            background: #07090c;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.game.icon;
                image-fit: cover;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.game.name;
                color: Theme.text;
                font-size: 18px;
                overflow: elide;
            }
            Text {
                text: root.game.serial;
                color: Theme.muted;
                font-size: 14px;
                overflow: elide;
            }
        }
        VerticalLayout {
            width: 170px;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.game.percent + "%";
                color: Theme.text;
                font-size: 22px;
                horizontal-alignment: right;
            }
            Text {
                text: "Earned " + root.game.earned + "/" + root.game.total;
                color: Theme.muted;
                font-size: 11px;
                horizontal-alignment: right;
            }
            Rectangle {
                height: 8px;
                background: #ffffff14;
                border-radius: 0px;
                Rectangle {
                    x: 0px;
                    width: parent.width * root.game.percent / 100;
                    background: Theme.accent;
                    border-radius: 0px;
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 10px;
            GradeCount { cup: Cups.platinum; count: root.game.platinum; }
            GradeCount { cup: Cups.gold; count: root.game.gold; }
            GradeCount { cup: Cups.silver; count: root.game.silver; }
            GradeCount { cup: Cups.bronze; count: root.game.bronze; }
        }
    }
}

export component TrophiesPage inherits Rectangle {
    callback back();
    background: Theme.bg;
    property <int> selected: -1;
    // Page-local view state: hidden trophies stay hidden until revealed.
    property <bool> reveal-hidden: false;

    VerticalLayout {
        padding: 18px;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 14px;
            Text {
                text: Trophies.detail-open ? Trophies.detail-game.name : "Trophies";
                color: Theme.text;
                font-size: 26px;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            if !Trophies.detail-open: Text {
                text: "Total " + Trophies.earned;
                color: Theme.text;
                font-size: 15px;
                vertical-alignment: center;
            }
            if Trophies.detail-open: Text {
                text: Trophies.detail-game.percent + "%  ·  Earned " + Trophies.detail-game.earned + "/" + Trophies.detail-game.total;
                color: Theme.text;
                font-size: 15px;
                vertical-alignment: center;
            }
            GradeCount { cup: Cups.platinum; count: Trophies.detail-open ? Trophies.detail-game.platinum : Trophies.platinum; size: 24px; }
            GradeCount { cup: Cups.gold; count: Trophies.detail-open ? Trophies.detail-game.gold : Trophies.gold; size: 24px; }
            GradeCount { cup: Cups.silver; count: Trophies.detail-open ? Trophies.detail-game.silver : Trophies.silver; size: 24px; }
            GradeCount { cup: Cups.bronze; count: Trophies.detail-open ? Trophies.detail-game.bronze : Trophies.bronze; size: 24px; }
            if Trophies.detail-open: VerticalLayout {
                alignment: center;
                AppCheckBox {
                    text: "Reveal hidden trophies";
                    checked <=> root.reveal-hidden;
                }
            }
            if Trophies.detail-open: VerticalLayout {
                alignment: center;
                AppButton {
                    text: "← All games";
                    clicked => {
                        root.reveal-hidden = false;
                        Trophies.detail-open = false;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 58px;
                    height: 40px;
                    border-radius: 0px;
                    background: back-touch.pressed ? #2b3345 : back-touch.has-hover ? #2b3345 : #1d212a;
                    animate background { duration: 100ms; }
                    Image {
                        x: 9px;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("icons/chevron-thin-left.svg");
                        colorize: Theme.muted;
                        width: 9px;
                        height: 20px;
                    }
                    Image {
                        x: 21px;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("icons/library.svg");
                        colorize: Theme.text;
                        width: 30px;
                        height: 30px;
                    }
                    back-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.back(); }
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.card-border;
            clip: true;
            if Trophies.detail-open: ScrollView {
                VerticalLayout {
                    alignment: start;
                    for item in Trophies.items: VerticalLayout {
                        TrophyItemRow { item: item; reveal: root.reveal-hidden; }
                        Rectangle {
                            height: 1px;
                            background: Theme.card-border;
                        }
                    }
                }
            }
            if !Trophies.detail-open: ScrollView {
                VerticalLayout {
                    alignment: start;
                    for game[i] in Trophies.games: VerticalLayout {
                        TrophyGameRow {
                            game: game;
                            selected: i == root.selected;
                            clicked => {
                                root.selected = i;
                                root.reveal-hidden = false;
                                Trophies.open-game(i);
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: Theme.card-border;
                        }
                    }
                }
            }
            if !Trophies.detail-open && Trophies.games.length == 0: VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: Trophies.loading ? "Reading trophies…" : "No games with trophies.";
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
                if !Trophies.loading && Trophies.run-dir != "": Text {
                    text: "Trophies appear here after you play. Unlocks are read from " + Trophies.run-dir + ".";
                    color: Theme.faint;
                    font-size: 11px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
