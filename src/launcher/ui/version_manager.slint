import { LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Theme, TextCell, HeaderCell, ThemedEdit, IconButton, InlineEdit, Selector, Chevron, AppButton, AppCheckBox } from "common.slint";

// ---- Version Manager: emulator builds the launcher can run ----

export struct ReleaseItem {
    text: string,
    installed: bool,
}

export struct EmuVersion {
    name: string,
    codename: string,
    date: string,
    path: string,    // the build's emulator exe
    tracked: bool,   // downloaded from the KytyPS5 releases, so it can be compared with newer ones
    renamable: bool, // false for the default KytyPS5-main
    shown: bool,   // ticked: listed in the toolbar's build menu
    active: bool,  // the build the launcher runs
    selected: bool, // highlighted in the Installed table (one of possibly several)
    pinned: bool,   // kept at the top of the Installed table (not the same as shown or active)
    main-latest: bool, // the default KytyPS5-main-latest build: always first, can not be pinned
}

// Right-click > About on an installed build (the C++ side fills it before the dialog opens).
export struct BuildAbout {
    title: string,
    author: string,          // the release repo's owner, or the config's author; "" for a local build
    date: string,
    path: string,            // the emulator exe
    size: string,            // the build folder on disk, e.g. "84.2 MB"
    global-config: string,   // cfgGlobal.json when the build ships one, else ""
    serial-configs: [string], // the cfg<serial>.json files it ships
    github: string,          // the release page, "" for a local build
}

// "Label   value" line of the About dialog; children (a button) go after the value.
component AboutRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 8px;
    Text {
        width: 110px;
        text: root.label;
        color: Theme.muted;
        font-size: 13px;
        vertical-alignment: center;
    }
    Text {
        horizontal-stretch: 1;
        text: root.value;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    @children
}

// Section label above a panel ("Installed", "Download", ...).
component SectionLabel inherits Text {
    color: Theme.text;
    font-size: 13px;
}

// Bordered, square panel for lists.
component Panel inherits Rectangle {
    background: #07090c;
    border-width: 1px;
    border-color: Theme.card-border;
    clip: true;
}

// A sortable header cell of the Installed table: click sorts by the column, the active one shows
// the direction. The grip on the right edge resizes it like HeaderCell does.
component SortHeader inherits Rectangle {
    in property <string> text;
    in-out property <length> w;
    in property <string> sort-key;   // the VM.sort-key this column sorts by
    in property <string> active-key;
    in property <bool> desc;
    in property <string> tooltip;
    callback clicked();
    property <bool> active: root.active-key == root.sort-key;
    width: root.w;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 14px;
        spacing: 3px;
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.text;
            color: root.active ? Theme.text : Theme.muted;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            visible: root.active;
            text: root.desc ? "▼" : "▲";
            color: Theme.accent;
            font-size: 10px;
            vertical-alignment: center;
        }
    }
    // Above the label; the resize grip, declared last, gets the pointer on the right edge.
    header-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Rectangle {
        x: parent.width - 1px;
        y: 5px;
        width: 1px;
        height: parent.height - 10px;
        background: grip.has-hover || grip.pressed ? Theme.accent : Theme.card-border;
    }
    grip := TouchArea {
        x: parent.width - 6px;
        width: 6px;
        mouse-cursor: col-resize;
        // The grip moves with the edge, so each move adds the delta since the last one.
        moved => {
            if (self.pressed) {
                root.w = max(40px, root.w + self.mouse-x - self.pressed-x);
            }
        }
    }
    if root.tooltip != "": Tooltip {
        text: @markdown("\{root.tooltip}");
    }
}

// One tab of a tab strip; the active one has an accent underline. Sized by its text.
export component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> has-menu: false;   // source tabs report right-clicks (the page owns the menu)
    in property <length> font-size: 13px;
    in property <brush> idle-color: Theme.muted;
    in property <string> tooltip;
    callback clicked();
    callback menu(length, length); // right-click, in window coordinates
    callback scrolled(length); // mouse wheel over the tab: the strip scrolls sideways
    in property <bool> renaming: false; // the title is an edit box
    callback rename-done(string);
    callback rename-cancel();
    // Full strip height: every tab's own bottom edge sits exactly on the strip's hairline. The active tab's cut
    // rectangle below then hides both its border and the hairline behind it, so it opens into the page.
    height: 28px;
    border-width: 1px;
    border-color: Theme.card-border;
    background: root.active ? Theme.bg : #141820;
    HorizontalLayout {
        padding-left: root.renaming ? 6px : 12px;
        padding-right: root.renaming ? 6px : 12px;
        padding-top: root.renaming ? 4px : 0px;
        padding-bottom: root.renaming ? 5px : 0px;
        if !root.renaming: Text {
            overflow: elide;
            text: root.text;
            color: root.active ? Theme.text : root.idle-color;
            font-size: root.font-size;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
        if root.renaming: InlineEdit {
            width: 150px;
            text: root.text;
            done(t) => { root.rename-done(t); }
            cancelled => { root.rename-cancel(); }
        }
    }
    // The active tab opens into the page below: its bottom edge is the page colour, cutting the strip's hairline.
    Rectangle {
        visible: root.active;
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.bg;
    }
    if root.tooltip != "": Tooltip {
        text: @markdown("\{root.tooltip}");
    }
    tab-touch := TouchArea {
        enabled: !root.renaming;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        scroll-event(event) => {
            root.scrolled(event.delta-y + event.delta-x);
            return accept;
        }
        pointer-event(event) => {
            if (root.has-menu && event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

component VersionRowView inherits Rectangle {
    in property <EmuVersion> version;
    in property <length> col-selected;
    in property <length> col-version;
    in property <length> col-codename;
    in property <length> col-date;
    in property <length> col-path;
    in property <length> col-tracked;
    in property <bool> renaming: false; // the name is an edit box
    callback pressed(bool, bool);  // left press: Ctrl, Shift
    callback toggled(bool);
    callback activated();          // double-click: the launcher runs this build
    callback menu(length, length); // right-click, in window coordinates
    // A left drag past 4 px: the marquee, in row coordinates (start: press point and Ctrl).
    callback drag-start(length, length, bool);
    callback drag-to(length, length);
    callback drag-end();
    property <bool> dragging;
    property <bool> press-ctrl;
    callback rename-done(string);
    callback rename-cancel();
    height: 22px;
    // The selected builds (the ones an action applies to) get the usual light highlight. The build
    // the launcher runs is marked by its name alone: blue and bold, with a dot before it.
    background: root.version.selected ? Theme.row-selected : touch.has-hover ? Theme.row-hover : transparent;
    property <color> cell-color: Theme.text;
    touch := TouchArea {
        enabled: !root.renaming;
        mouse-cursor: pointer;
        // Double-click: the launcher runs this build. It does not have to be shown in the list.
        double-clicked => { root.activated(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.press-ctrl = event.modifiers.control || event.modifiers.meta;
                root.pressed(root.press-ctrl, event.modifiers.shift);
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                root.drag-end();
            }
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        moved => {
            if (self.pressed) {
                if (!root.dragging && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px)) {
                    root.dragging = true;
                    root.drag-start(self.pressed-x, self.pressed-y, root.press-ctrl);
                }
                if (root.dragging) {
                    root.drag-to(self.mouse-x, self.mouse-y);
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: root.col-selected;
            AppCheckBox {
                checked: root.version.shown;
                toggled => { root.toggled(self.checked); }
            }
        }
        if !root.renaming: Rectangle {
            width: root.col-version;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                // A compact pin marker, distinct from the blue dot of the running build.
                if root.version.pinned: Image {
                    width: 11px;
                    height: 11px;
                    source: @image-url("icons/pin.svg");
                    colorize: Theme.muted;
                }
                Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    text: root.version.active ? "● " + root.version.name : root.version.name;
                    color: root.version.active ? Theme.accent : root.cell-color;
                    font-size: 13px;
                    font-weight: root.version.active ? 700 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        if root.renaming: Rectangle {
            width: root.col-version;
            InlineEdit {
                x: 2px;
                y: 1px;
                width: parent.width - 4px;
                height: parent.height - 2px;
                text: root.version.name;
                done(t) => { root.rename-done(t); }
                cancelled => { root.rename-cancel(); }
            }
        }
        TextCell { w: root.col-codename; text: root.version.codename; color: root.cell-color; }
        TextCell { w: root.col-date; text: root.version.date; color: root.cell-color; }
        TextCell { w: root.col-tracked; text: root.version.tracked ? "Yes" : "No"; color: root.cell-color; }
        TextCell { w: root.col-path; text: root.version.path; color: root.version.selected ? Theme.text : Theme.muted; }
    }
}

// State and actions of the Version Manager page (the C++ side talks to this global).
// The defaults of installed, available, older and sources are sample rows for the live preview only:
// VersionManager::Wire replaces all four models before the window shows.
export global VM {
    in-out property <string> versions-path;
    in property <[EmuVersion]> installed: [
        { name: "KytyPS5-main-latest", codename: "e5f0ee7", date: "2026-10-19", path: "C:\\Kyty\\versions\\KytyPS5-main-latest\\kyty_emulator.exe", tracked: true, renamable: true, shown: true, active: true },
        { name: "KytyPS5-2026-10-12-a1b2c3d", codename: "a1b2c3d", date: "2026-10-12", path: "C:\\Kyty\\versions\\KytyPS5-2026-10-12-a1b2c3d\\kyty_emulator.exe", tracked: true, renamable: true, shown: true, selected: true },
        { name: "NHL fork", codename: "9f8e7d6", date: "2026-10-05", path: "C:\\Kyty\\versions\\KytyPS5-nhl-p-2026-10-05-9f8e7d6\\kyty_emulator.exe", tracked: true, renamable: true, shown: false },
        { name: "KytyPS5-nhl-p", codename: "Local", date: "2026-10-18", path: "F:\\emuf\\KytyPS5-nhl-p\\build\\kyty_emulator.exe", tracked: false, renamable: true, shown: true },
    ];
    in property <[ReleaseItem]> available: [
        { text: "2026-10-19  e5f0ee7  (installed)", installed: true },
        { text: "2026-10-12  a1b2c3d  (installed)", installed: true },
        { text: "2026-10-08  77aa01f", installed: false },
        { text: "2026-10-01  3c4d5e6", installed: false },
    ];
    in property <[ReleaseItem]> older: [ // available without its first row (the Latest row lists that one)
        { text: "2026-10-12  a1b2c3d  (installed)", installed: true },
        { text: "2026-10-08  77aa01f", installed: false },
        { text: "2026-10-01  3c4d5e6", installed: false },
    ];
    in-out property <int> current-installed: 1; // the focused row of the selection (-1: none); 1 matches the preview rows
    in property <int> selected-count: 1;        // rows selected in the Installed table
    in property <bool> selected-all-shown;       // every selected build is ticked in the Show column
    callback show-selected(bool);                // tick / untick Show on every selected build
    in property <int> selected-latest-count;     // selected "-latest" builds (Update downloads their source's newest release)
    callback update-selected();
    // "A newer build is available" popup for the "-latest" builds, shown on any page (the C++ side fills it).
    in-out property <bool> update-prompt-open;
    in property <string> update-prompt-title: "A newer build is available";
    in property <string> update-prompt-text: "KytyPS5-main-latest: 2026-10-21  4644c52 (installed: 2026-10-20  f492027)";
    callback update-prompt-accept();
    // Search box and Any / Tracked / Local selector over the Installed table.
    in-out property <string> installed-filter;
    in-out property <int> installed-kind: 0;
    // Installed table sorting: the header key and direction, persisted in the app settings.
    in property <string> sort-key: "name";
    in property <bool> sort-desc: false;
    callback sort-by(string);
    callback filter-changed();
    in-out property <int> current-available: -1;
    in property <string> status: "Double-click a version to download it.";
    in property <bool> busy; // a download or list refresh is running
    // Release sources shown as tabs above the Download list.
    in property <[string]> sources: ["KytyPS5-main", "KytyPS5-nhl-p"];
    in-out property <int> current-source: 0;
    in-out property <bool> add-source-open;
    in property <bool> add-source-busy; // checking the link
    in-out property <string> add-source-error;
    // "Remove" asks first (the C++ side fills these and opens it); the file deletion is opt-in.
    in-out property <bool> remove-dialog-open;
    in property <int> remove-count;
    in property <string> remove-name;        // when one build is removed
    in property <bool> remove-has-tracked;   // a downloaded build is among them: offer to delete files
    in property <bool> remove-has-local;     // a local / custom build is among them (its files are never deleted)
    in property <int> remove-pinned-count;   // library games pinned to the builds being removed (their pins are kept)
    in-out property <bool> remove-delete-files;
    // Which installed build or source tab is being renamed in place (-1: none).
    in-out property <int> renaming-build: -1;
    in-out property <int> renaming-source: -1;
    // About dialog of one installed build; the default is a sample for the live preview.
    in-out property <bool> about-open;
    in property <BuildAbout> about: {
        title: "KytyPS5-2026-10-12-a1b2c3d",
        author: "KytyPS5",
        date: "2026-10-12",
        path: "C:\\Kyty\\versions\\KytyPS5-2026-10-12-a1b2c3d\\kyty_emulator.exe",
        size: "84.2 MB",
        global-config: "cfgGlobal.json",
        serial-configs: ["cfgPPSA34063.json", "cfgPPSA34064.json"],
        github: "https://github.com/KytyPS5/KytyPS5/releases/tag/KytyPS5-2026-10-12-a1b2c3d",
    };
    callback about-requested(int); // fill `about` for this table row
    callback about-show-file();    // the exe in the file browser
    callback about-open-link();    // the GitHub release page

    callback browse-path();
    callback select-version(int, bool); // Show checkbox: list the build in the toolbar menu
    callback activate-version(int);      // double-click: the launcher runs this build
    callback toggle-pin(int);            // Pin to top / Unpin the build at this table row
    callback add-custom();
    callback request-remove();          // asks about the selected builds
    callback confirm-remove(bool);      // also delete the files
    // Selection of the Installed table: press (row or -1, Ctrl, Shift), right-click, marquee, Ctrl+A.
    callback row-pressed(int, bool, bool);
    callback row-menu(int);
    callback marquee-begin(bool);      // keep the current selection (Ctrl held)
    callback marquee(int, int);        // rows first..last (clamped by the C++ side)
    callback select-all();
    callback refresh-installed();
    callback cancel-busy(); // stop the download or list refresh that is running
    callback refresh-available();
    callback download-version(int);
    callback open-release(int); // the release's page on GitHub
    callback select-source(int);
    callback opened(); // the page was opened: refresh both lists
    callback closed(); // the page was left: drop the release lists
    callback stop-tracking(int);
    callback rename-version(int, string);
    callback rename-source(int, string);
    callback add-source(string); // a GitHub repository (link or owner/repo)
    // Versions tab of the Settings page.
    // The token itself never reaches the UI: only whether one is set, and whether it can be saved.
    in property <bool> gh-token-set;
    in property <string> gh-token-hint; // e.g. "ghp_1a2b3c4d5e6f...", to tell which token is saved
    in property <bool> gh-token-storable: true; // false: no credential store on this platform
    in property <string> cache-info; // how many release lists are saved, and where
    callback gh-token-changed(string); // "" clears it
    callback settings-opened();
    callback delete-cache();
}

// Page of the main window: emulator builds the launcher can run.
export component VersionManagerPage inherits Rectangle {
    callback back();
    background: Theme.bg;

    // Under everything: a click on empty page space takes the focus, so an inline rename ends.
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                list-keys.focus();
            }
        }
    }

    // Right-click menu of the selected build (the row selects itself first); owned by the page
    // so a right-click on another row reaches it while the menu is open.
    // The menus are zero-sized: only rows and tabs open them, not a right-click on empty space.
    build-menu := ContextMenuArea {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        Menu {
            MenuItem {
                title: "Rename";
                enabled: VM.selected-count == 1 && VM.current-installed >= 0 && VM.current-installed < VM.installed.length
                    && VM.installed[VM.current-installed].renamable;
                activated => {
                    VM.renaming-build = VM.current-installed;
                }
            }
            // Pins keep a build at the top of the Installed table. This is not Show (the toolbar's
            // build list) and not the per-game emulator pin.
            MenuItem {
                title: VM.installed[VM.current-installed].pinned ? "Unpin" : "Pin to top";
                enabled: VM.selected-count == 1 && VM.current-installed >= 0 && VM.current-installed < VM.installed.length
                    && !VM.installed[VM.current-installed].main-latest;
                activated => { VM.toggle-pin(VM.current-installed); }
            }
            // The build the launcher runs. It can be set while it is not shown in the list.
            MenuItem {
                title: "Use this build";
                enabled: VM.selected-count == 1 && VM.current-installed >= 0 && VM.current-installed < VM.installed.length
                    && !VM.installed[VM.current-installed].active;
                activated => { VM.activate-version(VM.current-installed); }
            }
            // The selected "-latest" builds get their source's newest release.
            MenuItem {
                title: VM.selected-latest-count > 1 ? "Update " + VM.selected-latest-count + " builds" : "Update";
                enabled: !VM.busy && VM.selected-latest-count > 0;
                activated => { VM.update-selected(); }
            }
            // Show unless every selected build is already shown; then Hide.
            MenuItem {
                title: VM.selected-all-shown ? "Hide from the build list" : "Show in the build list";
                enabled: VM.selected-count > 0;
                activated => { VM.show-selected(!VM.selected-all-shown); }
            }
            MenuItem {
                title: VM.selected-count > 1 ? "Remove " + VM.selected-count + " builds" : "Remove";
                enabled: !VM.busy && VM.selected-count > 0;
                activated => { VM.request-remove(); }
            }
            MenuItem {
                title: "About";
                enabled: VM.selected-count == 1 && VM.current-installed >= 0 && VM.current-installed < VM.installed.length;
                activated => {
                    VM.about-requested(VM.current-installed);
                    VM.about-open = true;
                }
            }
        }
    }

    // Right-click menu of an added source tab (the tab is selected first).
    property <int> menu-source: -1;
    source-menu := ContextMenuArea {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        Menu {
            MenuItem {
                title: "Rename";
                activated => { VM.renaming-source = root.menu-source; }
            }
            MenuItem {
                title: "Stop tracking";
                activated => { VM.stop-tracking(root.menu-source); }
            }
        }
    }

    // Right-click menu of the selected release in the Download box (the row selects itself first).
    release-menu := ContextMenuArea {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        Menu {
            MenuItem {
                title: "Download";
                enabled: !VM.busy && VM.current-available >= 0 && VM.current-available < VM.available.length
                    && !VM.available[VM.current-available].installed;
                activated => { VM.download-version(VM.current-available); }
            }
            MenuItem {
                title: "GitHub page";
                enabled: VM.current-available >= 0 && VM.current-available < VM.available.length;
                activated => { VM.open-release(VM.current-available); }
            }
        }
    }

    // Marquee over the Installed rows: the start in list content coordinates, the pointer in
    // visible list coordinates (so auto-scroll moves the start, not the pointer).
    property <length> row-h: 22px;
    property <bool> mq-on;
    property <length> mq-x0;
    property <length> mq-y0;
    property <length> mq-vx;
    property <length> mq-vy;
    function mq-start(cx: length, cy: length, additive: bool) {
        root.mq-on = true;
        root.mq-x0 = cx;
        root.mq-y0 = cy;
        root.mq-vx = cx + build-list.content-x;
        root.mq-vy = cy + build-list.content-y;
        VM.marquee-begin(additive);
    }
    function mq-move(vx: length, vy: length) {
        root.mq-vx = vx;
        root.mq-vy = vy;
        root.mq-apply();
    }
    function mq-apply() {
        VM.marquee(
            floor(min(root.mq-y0, root.mq-vy - build-list.content-y) / root.row-h),
            floor(max(root.mq-y0, root.mq-vy - build-list.content-y) / root.row-h));
    }
    // Dragging above or below the list scrolls it.
    Timer {
        interval: 30ms;
        running: root.mq-on && (root.mq-vy < 0px || root.mq-vy > build-list.visible-height);
        triggered => {
            build-list.content-y = max(min(0px, build-list.visible-height - build-list.content-height),
                min(0px, build-list.content-y + (root.mq-vy < 0px ? 1 : -1) * root.row-h / 2));
            root.mq-apply();
        }
    }
    // Ctrl+A and Delete while the Installed table has been clicked.
    list-keys := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if ((event.modifiers.control || event.modifiers.meta) && (event.text == "a" || event.text == "A")) {
                VM.select-all();
                return accept;
            }
            if (event.text == Key.Delete && VM.selected-count > 0) {
                VM.request-remove();
                return accept;
            }
            return reject;
        }
    }
    function do-remove() {
        VM.remove-dialog-open = false;
        VM.confirm-remove(VM.remove-delete-files);
    }

    // Share of the width the Installed box takes; the handle between the boxes changes it.
    property <float> split: 0.72;

    // The older builds under "Latest" are listed until the chevron folds them away.
    property <bool> older-open: true;

    // Installed table column widths (resizable from the header).
    property <length> col-selected: 60px;
    property <length> col-version: 140px;
    property <length> col-codename: 100px;
    property <length> col-date: 100px;
    property <length> col-path: 220px;
    property <length> col-tracked: 80px;
    property <length> cols-total: root.col-selected + root.col-version + root.col-codename + root.col-date + root.col-path + root.col-tracked;
    // The last column (Path) fills whatever width the other columns leave, so long paths get the spare room.
    property <length> col-path-eff: root.col-path + max(0px, build-list.visible-width - root.cols-total);

    VerticalLayout {
        padding: 18px;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 10px;
            Text {
                overflow: elide;
                text: "Version Manager";
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 58px;
                height: 40px;
                border-radius: 0px;
                background: back-touch.pressed ? #2b3345 : back-touch.has-hover ? #2b3345 : #1d212a;
                animate background { duration: 100ms; }
                Image {
                    x: 9px;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("icons/chevron-thin-left.svg");
                    colorize: Theme.muted;
                    width: 9px;
                    height: 20px;
                }
                Image {
                    x: 21px;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("icons/library.svg");
                    colorize: Theme.text;
                    width: 30px;
                    height: 30px;
                }
                back-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.back(); }
                }
            }
        }


        SectionLabel { text: "Path to save versions"; }
        Rectangle {
            border-width: 1px;
            border-color: Theme.card-border;
            HorizontalLayout {
                padding: 10px;
                spacing: 8px;
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> VM.versions-path;
                    // Enter applies the typed folder, like Browse does.
                    accepted => { VM.refresh-installed(); }
                }
                AppButton {
                    width: 100px;
                    text: "Browse";
                    clicked => { VM.browse-path(); }
                }
            }
        }

        // The two boxes with a drag handle between them: one shrinks, the other grows.
        split-area := Rectangle {
            vertical-stretch: 1;
            property <length> handle-w: 16px;
            property <length> min-left: 420px;
            property <length> min-right: 240px;
            // Left box width; the right one takes the rest.
            property <length> left-w: max(self.min-left, min(self.width * root.split, self.width - self.min-right - self.handle-w));

            // Installed builds.
            VerticalLayout {
                x: 0px;
                y: 0px;
                width: split-area.left-w;
                height: parent.height;
                spacing: 6px;
                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    SectionLabel { text: "Installed"; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        // 0.30 of the room the search box had (the box minus the heading, selector and refresh icon).
                        width: max(70px, (split-area.left-w - 270px) * 0.30);
                        ThemedEdit {
                            height: 26px;
                            min-width: 60px;
                            placeholder: "Search builds";
                            text <=> VM.installed-filter;
                            edited(t) => {
                                VM.current-installed = -1;
                                VM.filter-changed();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Selector {
                            width: 110px;
                            model: ["Any", "Tracked", "Local"];
                            current-index <=> VM.installed-kind;
                            selected(i) => {
                                VM.current-installed = -1;
                                VM.filter-changed();
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            width: 22px;
                            height: 20px;
                            icon-size: 15px;
                            icon: @image-url("icons/refresh.svg");
                            tooltip: "Refresh the installed builds";
                            clicked => { VM.refresh-installed(); }
                        }
                    }
                }
                installed-panel := Panel {
                    vertical-stretch: 1;
                    // The empty space under the rows (the list lets mouse presses through there):
                    // a press clears the selection, a drag starts a marquee.
                    empty-touch := TouchArea {
                        y: 24px;
                        height: parent.height - 24px;
                        property <bool> dragging;
                        property <bool> press-ctrl;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                self.press-ctrl = event.modifiers.control || event.modifiers.meta;
                                VM.row-pressed(-1, self.press-ctrl, false);
                                list-keys.focus();
                            }
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && self.dragging) {
                                self.dragging = false;
                                root.mq-on = false;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                if (!self.dragging && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px)) {
                                    self.dragging = true;
                                    root.mq-start(self.pressed-x - build-list.content-x, self.pressed-y - build-list.content-y, self.press-ctrl);
                                }
                                if (self.dragging) {
                                    root.mq-move(self.mouse-x, self.mouse-y);
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        Rectangle {
                            height: 24px;
                            background: #07090cd9;
                            clip: true;
                            // The header follows the rows when the list scrolls sideways.
                            HorizontalLayout {
                                x: build-list.content-x;
                                width: root.cols-total + max(0px, build-list.visible-width - root.cols-total);
                                spacing: 0px;
                                HeaderCell { text: "Show"; w <=> root.col-selected; tooltip: "Listed in the toolbar's build list. The build the launcher runs is always listed."; }
                                SortHeader {
                                    text: "Version";
                                    w <=> root.col-version;
                                    sort-key: "name";
                                    active-key: VM.sort-key;
                                    desc: VM.sort-desc;
                                    tooltip: "Sort by display name";
                                    clicked => { VM.sort-by("name"); }
                                }
                                SortHeader {
                                    text: "Codename";
                                    w <=> root.col-codename;
                                    sort-key: "codename";
                                    active-key: VM.sort-key;
                                    desc: VM.sort-desc;
                                    tooltip: "Sort by codename";
                                    clicked => { VM.sort-by("codename"); }
                                }
                                SortHeader {
                                    text: "Date";
                                    w <=> root.col-date;
                                    sort-key: "date";
                                    active-key: VM.sort-key;
                                    desc: VM.sort-desc;
                                    tooltip: "Sort by release date";
                                    clicked => { VM.sort-by("date"); }
                                }
                                SortHeader {
                                    text: "Tracked?";
                                    w <=> root.col-tracked;
                                    sort-key: "tracked";
                                    active-key: VM.sort-key;
                                    desc: VM.sort-desc;
                                    tooltip: "Sort downloaded builds first";
                                    clicked => { VM.sort-by("tracked"); }
                                }
                                SortHeader {
                                    text: "Path";
                                    w: root.col-path-eff;
                                    sort-key: "path";
                                    active-key: VM.sort-key;
                                    desc: VM.sort-desc;
                                    tooltip: "Sort by path";
                                    clicked => { VM.sort-by("path"); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.card-border;
                            }
                        }
                        build-list := ListView {
                            vertical-stretch: 1;
                            // Columns past the right edge are reached by scrolling sideways.
                            content-width: max(self.visible-width, root.cols-total);
                            for v[i] in VM.installed: VersionRowView {
                                width: max(build-list.visible-width, root.cols-total);
                                version: v;
                                col-selected: root.col-selected;
                                col-version: root.col-version;
                                col-codename: root.col-codename;
                                col-date: root.col-date;
                                col-tracked: root.col-tracked;
                                col-path: root.col-path-eff;
                                pressed(ctrl, shift) => {
                                    VM.row-pressed(i, ctrl, shift);
                                    list-keys.focus();
                                }
                                drag-start(x, y, ctrl) => { root.mq-start(x, i * root.row-h + y, ctrl); }
                                drag-to(x, y) => { root.mq-move(x + build-list.content-x, i * root.row-h + y + build-list.content-y); }
                                drag-end => { root.mq-on = false; }
                                toggled(on) => { VM.select-version(i, on); }
                                activated => { VM.activate-version(i); }
                                renaming: i == VM.renaming-build;
                                rename-done(t) => {
                                    VM.renaming-build = -1;
                                    VM.rename-version(i, t);
                                }
                                rename-cancel => { VM.renaming-build = -1; }
                                menu(x, y) => {
                                    VM.row-menu(i);
                                    build-menu.show({ x: x - build-menu.absolute-position.x, y: y - build-menu.absolute-position.y });
                                }
                            }
                        }
                    }
                    if root.mq-on: Rectangle {
                        y: 24px;
                        height: parent.height - 24px;
                        clip: true;
                        Rectangle {
                            x: min(root.mq-x0 + build-list.content-x, root.mq-vx);
                            y: min(root.mq-y0 + build-list.content-y, root.mq-vy);
                            width: abs(root.mq-vx - root.mq-x0 - build-list.content-x);
                            height: abs(root.mq-vy - root.mq-y0 - build-list.content-y);
                            background: Theme.accent.with-alpha(0.18);
                            border-width: 1px;
                            border-color: Theme.accent;
                        }
                    }
                }
                HorizontalLayout {
                    height: 24px;
                    spacing: 2px;
                    IconButton {
                        width: 26px;
                        height: 24px;
                        icon-size: 17px;
                        icon: @image-url("icons/folder-add.svg");
                        tooltip: "Add a custom build";
                        clicked => { VM.add-custom(); }
                    }
                    IconButton {
                        width: 26px;
                        height: 24px;
                        icon-size: 17px;
                        icon: @image-url("icons/remove-configuration.svg");
                        // Only takes the build off the list; a downloaded build's folder is kept.
                        tooltip: "Remove the selected builds from the list";
                        enabled: !VM.busy && VM.selected-count > 0;
                        clicked => { VM.request-remove(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: VM.installed.length == 1 ? "1 build installed" : VM.installed.length + " builds installed";
                            color: Theme.muted;
                            font-size: 12px;
                        }
                    }
                }
            }

            // Drag handle between the boxes.
            Rectangle {
                x: split-area.left-w;
                y: 0px;
                width: split-area.handle-w;
                height: parent.height;
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 4px;
                    height: parent.height * 0.60;
                    border-radius: 0px;
                    // Visible at rest (it was as dark as the box borders), accent while hovered or dragged.
                    background: split-touch.has-hover || split-touch.pressed ? Theme.accent : #3e4c66;
                    animate background { duration: 100ms; }
                }
                // Only the bar's height: above and below it is empty space.
                split-touch := TouchArea {
                    y: (parent.height - self.height) / 2;
                    height: parent.height * 0.60;
                    mouse-cursor: col-resize;
                    moved => {
                        if (self.pressed) {
                            root.split = max(split-area.min-left, min(split-area.left-w + self.mouse-x - self.pressed-x, split-area.width - split-area.min-right - split-area.handle-w)) / split-area.width;
                        }
                    }
                }
            }

            // Builds available to download.
            VerticalLayout {
                x: split-area.left-w + split-area.handle-w;
                y: 0px;
                width: split-area.width - split-area.left-w - split-area.handle-w;
                height: parent.height;
                spacing: 6px;
                // Download sources: one tab per GitHub repository; + adds one.
                HorizontalLayout {
                    height: 28px;
                    spacing: 2px;
                    // The tabs scroll sideways (wheel, drag or touchpad) when there are more than fit.
                    tabs-flick := Flickable {
                        horizontal-stretch: 0;
                        preferred-width: tabs-row.preferred-width;
                        min-width: 0px;
                        content-width: tabs-row.preferred-width;
                        content-height: self.height;
                        tabs-row := HorizontalLayout {
                            x: 0px;
                            spacing: 2px;
                            for name[i] in VM.sources: TabButton {
                                text: name;
                                active: i == VM.current-source;
                                has-menu: true;
                                clicked => {
                                    list-keys.focus();
                                    VM.select-source(i);
                                }
                                // Selects the tab; added sources (not the default one) have the menu.
                                menu(x, y) => {
                                    VM.select-source(i);
                                    if (i > 0) {
                                        root.menu-source = i;
                                        source-menu.show({ x: x - source-menu.absolute-position.x, y: y - source-menu.absolute-position.y });
                                    }
                                }
                                renaming: i == VM.renaming-source;
                                rename-done(t) => {
                                    VM.renaming-source = -1;
                                    VM.rename-source(i, t);
                                }
                                rename-cancel => { VM.renaming-source = -1; }
                                scrolled(d) => {
                                    tabs-flick.content-x = min(0px, max(tabs-flick.width - tabs-flick.content-width, tabs-flick.content-x + d));
                                }
                            }
                        }
                    }
                    // Stays in view at the right end of the strip.
                    TabButton {
                        text: "+";
                        font-size: 18px;
                        idle-color: Theme.text;
                        tooltip: "Add a release source";
                        clicked => {
                            VM.add-source-error = "";
                            VM.add-source-open = true;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            width: 22px;
                            height: 20px;
                            icon-size: 15px;
                            icon: @image-url("icons/refresh.svg");
                            tooltip: "Refresh the list of releases";
                            enabled: !VM.busy;
                            clicked => { VM.refresh-available(); }
                        }
                    }
                }
                Panel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        Rectangle {
                            height: 24px;
                            background: #07090cd9;
                            Text {
                                overflow: elide;
                                x: 8px;
                                text: "Version";
                                color: Theme.muted;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.card-border;
                            }
                        }
                        // "Latest" is the newest build; the chevron shows or hides the older ones under it.
                        Rectangle {
                            height: 26px;
                            background: VM.current-available == 0 ? Theme.accent.with-alpha(0.55) : latest-touch.has-hover ? Theme.row-hover : transparent;
                            latest-touch := TouchArea {
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                        VM.current-available = 0;
                                        release-menu.show({
                                            x: self.absolute-position.x + self.mouse-x - release-menu.absolute-position.x,
                                            y: self.absolute-position.y + self.mouse-y - release-menu.absolute-position.y });
                                    }
                                }
                                clicked => { VM.current-available = 0; }
                                double-clicked => {
                                    if (!VM.busy && VM.available.length > 0) {
                                        VM.download-version(0);
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 0px;
                                padding-right: 18px; // lines its button up with the rows' below
                                spacing: 6px;
                                Rectangle {
                                    width: 26px;
                                    background: chevron-touch.has-hover ? #ffffff1a : transparent;
                                    Chevron {
                                        width: 14px;
                                        height: 14px;
                                        angle: root.older-open ? 90deg : 0deg;
                                        animate angle { duration: 120ms; }
                                    }
                                    chevron-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.older-open = !root.older-open; }
                                    }
                                    Tooltip {
                                        text: root.older-open ? @markdown("Hide older builds") : @markdown("Show older builds");
                                    }
                                }
                                Text {
                                    overflow: elide;
                                    text: "Latest";
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: VM.available.length > 0 ? VM.available[0].text : "";
                                    color: Theme.muted;
                                    font-size: 13px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                if VM.available.length > 0: VerticalLayout {
                                    alignment: center;
                                    IconButton {
                                        width: 24px;
                                        height: 22px;
                                        icon-size: 14px;
                                        icon: @image-url("icons/download.svg");
                                        tooltip: VM.available[0].installed ? "Already installed" : "Download";
                                        enabled: !VM.busy && !VM.available[0].installed;
                                        clicked => { VM.download-version(0); }
                                    }
                                }
                            }
                        }
                        // A ListView builds only the rows in view (there can be hundreds); its row i is release i + 1,
                        // since the Latest row above lists release 0.
                        if root.older-open: ListView {
                            vertical-stretch: 1;
                            for item[i] in VM.older: Rectangle {
                                height: 22px;
                                background: i + 1 == VM.current-available ? Theme.accent.with-alpha(0.55) : dl-touch.has-hover ? Theme.row-hover : transparent;
                                Text {
                                    overflow: elide;
                                    x: 32px;
                                    text: item.text;
                                    color: Theme.text;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                dl-touch := TouchArea {
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                            VM.current-available = i + 1;
                                            release-menu.show({
                                                x: self.absolute-position.x + self.mouse-x - release-menu.absolute-position.x,
                                                y: self.absolute-position.y + self.mouse-y - release-menu.absolute-position.y });
                                        }
                                    }
                                    clicked => { VM.current-available = i + 1; }
                                    double-clicked => {
                                        if (!VM.busy) {
                                            VM.download-version(i + 1);
                                        }
                                    }
                                }
                                IconButton {
                                    x: parent.width - self.width - 20px; // clear of the list's scrollbar
                                    y: (parent.height - self.height) / 2;
                                    width: 24px;
                                    height: 20px;
                                    icon-size: 14px;
                                    icon: @image-url("icons/download.svg");
                                    tooltip: item.installed ? "Already installed" : "Download";
                                    enabled: !VM.busy && !item.installed;
                                    clicked => { VM.download-version(i + 1); }
                                }
                            }
                        }
                        // Keeps the Latest row at the top when the list is closed.
                        if !root.older-open: Rectangle { vertical-stretch: 1; }
                    }
                }
                HorizontalLayout {
                    height: 24px;
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: VM.status;
                        color: Theme.muted;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    if VM.busy: AppButton {
                        width: 70px;
                        text: "Cancel";
                        clicked => { VM.cancel-busy(); }
                    }
                }
            }
        }
    }

    // "Add source" dialog: a dimmed overlay with a box in the middle.
    if VM.add-source-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #000000a0;
        // Swallows clicks outside the box.
        TouchArea { }
        Rectangle {
            width: min(480px, root.width - 48px);
            height: dialog-box.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 3;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            dialog-box := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    overflow: elide;
                    text: "Add a release source";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                }
                Text {
                    text: "Paste the GitHub repository, (e.g. https://github.com/KytyPS5/KytyPS5 or just KytyPS5/KytyPS5) Private repos require a GH_TOKEN with read access";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                link-edit := ThemedEdit {
                    placeholder: "https://github.com/owner/repo";
                    editable: !VM.add-source-busy;
                    accepted => {
                        if (!VM.add-source-busy) {
                            VM.add-source(self.text);
                        }
                    }
                }
                Text {
                    visible: VM.add-source-error != "" || VM.add-source-busy;
                    text: VM.add-source-busy ? "Checking the link…" : VM.add-source-error;
                    color: VM.add-source-busy ? Theme.muted : Theme.danger;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    AppButton {
                        text: "Cancel";
                        clicked => { VM.add-source-open = false; }
                    }
                    AppButton {
                        text: "Add";
                        primary: true;
                        enabled: !VM.add-source-busy && link-edit.text != "";
                        clicked => { VM.add-source(link-edit.text); }
                    }
                }
            }
        }
    }

    // "Remove" on the selected builds: the file deletion is opt-in (downloaded builds only).
    if VM.remove-dialog-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #000000a0;
        // Swallows clicks outside the box.
        TouchArea { }
        Rectangle {
            width: min(460px, root.width - 48px);
            height: remove-box.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 3;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            border-radius: 0px;
            // Escape cancels, Enter removes.
            FocusScope {
                x: 0px;
                y: 0px;
                width: 0px;
                height: 0px;
                init => { self.focus(); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        VM.remove-dialog-open = false;
                        return accept;
                    }
                    if (event.text == Key.Return) {
                        root.do-remove();
                        return accept;
                    }
                    return reject;
                }
            }
            remove-box := VerticalLayout {
                padding: 20px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: start;
                        Image {
                            source: @image-url("icons/warning.svg");
                            width: 28px;
                            height: 28px;
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: VM.remove-count == 1 ? "Remove build" : "Remove " + VM.remove-count + " builds";
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        Text {
                            text: VM.remove-count == 1 ? "Remove \"" + VM.remove-name + "\" from the list?"
                                : "Remove the " + VM.remove-count + " selected builds from the list?";
                            color: Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        if VM.remove-has-tracked: Text {
                            text: VM.remove-count == 1 ? "Its folder stays on disk unless you tick the box below."
                                : "Downloaded build folders stay on disk unless you tick the box below.";
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if VM.remove-pinned-count > 0: Text {
                            text: VM.remove-pinned-count == 1 ? "1 game is pinned to " + (VM.remove-count == 1 ? "this build" : "these builds")
                                : VM.remove-pinned-count + " games are pinned to " + (VM.remove-count == 1 ? "this build" : "these builds");
                            color: Theme.text;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if VM.remove-has-local: Text {
                            text: "Local files can not be deleted by Version Manager.";
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
                if VM.remove-has-tracked: AppCheckBox {
                    text: "Also delete the downloaded files";
                    checked <=> VM.remove-delete-files;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    AppButton {
                        text: "Cancel";
                        clicked => { VM.remove-dialog-open = false; }
                    }
                    // Red: the destructive choice.
                    Rectangle {
                        width: 96px;
                        border-radius: 0px;
                        background: rm-touch.pressed ? Theme.danger.darker(0.2) : rm-touch.has-hover ? Theme.danger-hover : Theme.danger;
                        Text {
                            text: VM.remove-delete-files ? "Delete" : "Remove";
                            color: #ffffff;
                            font-size: 13px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        rm-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.do-remove(); }
                        }
                    }
                }
            }
        }
    }

    // Right-click > About on an installed build.
    if VM.about-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #000000a0;
        // A click outside the box closes it.
        TouchArea {
            clicked => { VM.about-open = false; }
        }
        Rectangle {
            width: min(600px, root.width - 48px);
            height: about-box.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 3;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            border-radius: 0px;
            // Clicks inside the box don't reach the overlay.
            TouchArea { }
            // Escape and Enter close it.
            FocusScope {
                x: 0px;
                y: 0px;
                width: 0px;
                height: 0px;
                init => { self.focus(); }
                key-pressed(event) => {
                    if (event.text == Key.Escape || event.text == Key.Return) {
                        VM.about-open = false;
                        return accept;
                    }
                    return reject;
                }
            }
            about-box := VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text {
                    text: VM.about.title;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                    overflow: elide;
                }
                Rectangle { height: 4px; }
                AboutRow {
                    label: "Author";
                    value: VM.about.author != "" ? VM.about.author : "Unknown (local build)";
                }
                AboutRow {
                    label: "Date";
                    value: VM.about.date;
                }
                AboutRow {
                    label: "Install size";
                    value: VM.about.size;
                }
                AboutRow {
                    label: "Path";
                    value: VM.about.path;
                    AppButton {
                        text: "Go to file";
                        clicked => { VM.about-show-file(); }
                    }
                }
                AboutRow {
                    label: "Global config";
                    value: VM.about.global-config != "" ? VM.about.global-config : "None";
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 110px;
                        text: "Serial configs";
                        color: Theme.muted;
                        font-size: 13px;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        if VM.about.serial-configs.length == 0: Text {
                            text: "None";
                            color: Theme.text;
                            font-size: 13px;
                        }
                        // Many config files scroll instead of stretching the dialog (the C++ side caps the list).
                        if VM.about.serial-configs.length > 0: ScrollView {
                            height: min(96px, max(18px, VM.about.serial-configs.length * 18px));
                            VerticalLayout {
                                spacing: 2px;
                                for cfg in VM.about.serial-configs: Text {
                                    text: cfg;
                                    color: Theme.text;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 110px;
                        text: "GitHub";
                        color: Theme.muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    if VM.about.github == "": Text {
                        horizontal-stretch: 1;
                        text: "None (local build)";
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    if VM.about.github != "": Rectangle {
                        horizontal-stretch: 1;
                        height: 20px;
                        Text {
                            width: parent.width;
                            text: VM.about.github;
                            color: link-touch.has-hover ? Theme.accent-hover : Theme.accent;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        link-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { VM.about-open-link(); }
                        }
                    }
                }
                Rectangle { height: 6px; }
                HorizontalLayout {
                    alignment: end;
                    AppButton {
                        text: "Close";
                        primary: true;
                        clicked => { VM.about-open = false; }
                    }
                }
            }
        }
    }
}
