#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// NHL 27 FSR: cleans the B10G11R11 colour handed to the host FSR upscaler. Some pixels of the game's
// colour hold Inf/NaN or near-maximum values (63963) next to ordinary ones; the game's own upscaler
// hides them, FSR turns them into white sparkles. A pixel that is broken, brighter than `cap`, or a
// lone bright dot (brighter than `floor_luma` and `ratio` times its brightest 4-neighbour) is replaced
// by the average of its usable 4-neighbours. Everything else is copied unchanged.
layout(local_size_x = 8, local_size_y = 8) in;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Src { uint px[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Dst { uint px[]; };
layout(push_constant, std430) uniform Params {
	uint64_t src;
	uint64_t dst;
	uint     width;
	uint     height;
	float    ratio;
	float    floor_luma;
	float    cap;
	uint     reserved;
} p;

bool Broken(uint w) {
	return ((w >> 6) & 31u) == 31u || ((w >> 17) & 31u) == 31u || ((w >> 27) & 31u) == 31u;
}
vec3 Unpack(uint w) {
	// An 11-bit (10-bit) unsigned float shifted left by 4 (5) bits is the same half-float.
	return vec3(unpackHalf2x16((w & 0x7ffu) << 4).x, unpackHalf2x16(((w >> 11) & 0x7ffu) << 4).x,
				unpackHalf2x16((w >> 22) << 5).x);
}
uint Pack(vec3 c) {
	c = clamp(c, vec3(0.0), vec3(64512.0));
	const uint r = (packHalf2x16(vec2(c.r, 0.0)) >> 4) & 0x7ffu;
	const uint g = (packHalf2x16(vec2(c.g, 0.0)) >> 4) & 0x7ffu;
	const uint b = (packHalf2x16(vec2(c.b, 0.0)) >> 5) & 0x3ffu;
	return r | (g << 11) | (b << 22);
}
float Luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

void main() {
	const uvec2 at = gl_GlobalInvocationID.xy;
	if (at.x >= p.width || at.y >= p.height) return;
	Src src = Src(p.src);
	Dst dst = Dst(p.dst);
	const uint index = at.y * p.width + at.x;
	const uint word  = src.px[index];
	const ivec2 offsets[4] = ivec2[4](ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
	vec3  sum = vec3(0.0);
	float count = 0.0, brightest = 0.0;
	for (int i = 0; i < 4; ++i) {
		const ivec2 n = ivec2(at) + offsets[i];
		if (n.x < 0 || n.y < 0 || n.x >= int(p.width) || n.y >= int(p.height)) continue;
		const uint nw = src.px[uint(n.y) * p.width + uint(n.x)];
		if (Broken(nw)) continue;
		const vec3  nc = Unpack(nw);
		const float nl = Luma(nc);
		if (nl > p.cap) continue;
		sum += nc;
		count += 1.0;
		brightest = max(brightest, nl);
	}
	bool replace = Broken(word);
	if (!replace) {
		const float l = Luma(Unpack(word));
		replace = l > p.cap || (l > p.floor_luma && l > p.ratio * brightest);
	}
	dst.px[index] = replace ? Pack(count > 0.0 ? sum / count : vec3(0.0)) : word;
}
