#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// NHL 27 FSR 4 ghost guard: builds a reactive mask that tells FSR 4 where to stop trusting its history.
// FSR 3.1 throws history away wherever it no longer fits the current picture (colour clamping); FSR 4
// trusts the game's motion vectors and keeps ghost copies of things whose motion they don't describe.
// mode 0: a pixel is reactive when last frame's colour, fetched along the motion vector, lies clearly
//         outside the colour range of the current 3x3 neighbourhood.
// mode 1: erode (3x3 minimum), so single pixels and thin lines that change with jitter stay unmarked.
// mode 2: dilate (3x3 maximum) and pack 4 pixels per word into the R8 mask; optionally tint the colour
//         red where the mask is set (debug view). FSR 4.1 ignores reactive masks, so with flag 8 the
//         motion vectors of marked pixels are also pointed off screen: FSR 4 then has no history to
//         reuse there and draws them from the current frame only.
// Colours are B10G11R11 words, motion is RG16F (game units, scaled to pixels by mv), masks are floats.
layout(local_size_x = 8, local_size_y = 8) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Floats { float v[]; };
layout(push_constant, std430) uniform Params {
	uint64_t cur;    // current colour
	uint64_t prev;   // last frame's colour
	uint64_t motion; // current motion vectors
	uint64_t src;    // mask in (modes 1, 2)
	uint64_t dst;    // mask out (modes 0, 1) / packed R8 mask (mode 2)
	uint64_t show;   // tinted colour out (mode 2, flag 4)
	uint64_t motion_out; // motion vectors out (mode 2, flag 8)
	uint     width;
	uint     height;
	float    mv_x;   // motion scale to pixels (FSR motionVectorScale)
	float    mv_y;
	float    threshold;
	float    gain;
	uint     mode;
	uint     flags;  // 1 = previous colour valid, 2 = erode, 4 = tint, 8 = motion out
} p;

vec3 Unpack(uint w) {
	return vec3(unpackHalf2x16((w & 0x7ffu) << 4).x, unpackHalf2x16(((w >> 11) & 0x7ffu) << 4).x,
				unpackHalf2x16((w >> 22) << 5).x);
}
uint Pack(vec3 c) {
	c = clamp(c, vec3(0.0), vec3(64512.0));
	const uint r = (packHalf2x16(vec2(c.r, 0.0)) >> 4) & 0x7ffu;
	const uint g = (packHalf2x16(vec2(c.g, 0.0)) >> 4) & 0x7ffu;
	const uint b = (packHalf2x16(vec2(c.b, 0.0)) >> 5) & 0x3ffu;
	return r | (g << 11) | (b << 22);
}
// Reversible tonemap, as FSR uses internally, so very bright pixels don't dominate.
vec3 Tone(vec3 c) {
	c = min(c, vec3(1024.0));
	return c / (1.0 + max(c.r, max(c.g, c.b)));
}
uint Index(ivec2 q) {
	q = clamp(q, ivec2(0), ivec2(int(p.width) - 1, int(p.height) - 1));
	return uint(q.y) * p.width + uint(q.x);
}
vec3 Cur(ivec2 q) { return Tone(Unpack(Words(p.cur).v[Index(q)])); }
vec3 Prev(ivec2 q) { return Tone(Unpack(Words(p.prev).v[Index(q)])); }
float Mask(ivec2 q) { return Floats(p.src).v[Index(q)]; }

float Raw(ivec2 at) {
	if ((p.flags & 1u) == 0u) return 0.0;
	vec3 lo = vec3(1e9), hi = vec3(-1e9);
	for (int y = -1; y <= 1; ++y) {
		for (int x = -1; x <= 1; ++x) {
			const vec3 c = Cur(at + ivec2(x, y));
			lo = min(lo, c);
			hi = max(hi, c);
		}
	}
	const vec2 mv = unpackHalf2x16(Words(p.motion).v[Index(at)]);
	const vec2 pos = vec2(at) + 0.5 + mv * vec2(p.mv_x, p.mv_y); // where this pixel was last frame
	if (any(isnan(pos)) || pos.x < 0.0 || pos.y < 0.0 || pos.x > float(p.width) || pos.y > float(p.height))
		return 0.0; // came from off screen: nothing to ghost
	const vec2  f = pos - 0.5;
	const ivec2 b = ivec2(floor(f));
	const vec2  t = f - vec2(b);
	const vec3  prev = mix(mix(Prev(b), Prev(b + ivec2(1, 0)), t.x),
						   mix(Prev(b + ivec2(0, 1)), Prev(b + ivec2(1, 1)), t.x), t.y);
	const vec3  outside = max(lo - prev, prev - hi);
	const float d = max(max(outside.r, outside.g), outside.b);
	return clamp((d - p.threshold) * p.gain, 0.0, 1.0);
}

void main() {
	const ivec2 at = ivec2(gl_GlobalInvocationID.xy);
	if (p.mode == 2u) {
		// One thread per 4 consecutive pixels (row-major), one packed word each.
		const uint groups_x = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
		const uint word = gl_GlobalInvocationID.y * groups_x + gl_GlobalInvocationID.x;
		const uint total = p.width * p.height;
		if (word * 4u >= total) return;
		uint packed = 0u;
		for (uint k = 0u; k < 4u; ++k) {
			const uint i = word * 4u + k;
			if (i >= total) break;
			const ivec2 q = ivec2(int(i % p.width), int(i / p.width));
			float m = 0.0;
			for (int y = -1; y <= 1; ++y)
				for (int x = -1; x <= 1; ++x) m = max(m, Mask(q + ivec2(x, y)));
			packed |= uint(round(clamp(m, 0.0, 1.0) * 255.0)) << (8u * k);
			if ((p.flags & 4u) != 0u) {
				const vec3  c = Unpack(Words(p.cur).v[i]);
				const float l = max(dot(c, vec3(0.2126, 0.7152, 0.0722)), 0.5);
				Words(p.show).v[i] = Pack(mix(c, vec3(4.0 * l, 0.0, 0.0), 0.85 * m));
			}
			if ((p.flags & 8u) != 0u) {
				uint mv = Words(p.motion).v[i];
				// Two screens away: well outside the previous frame whatever the sign of the scale.
				if (m >= 0.5) mv = packHalf2x16(vec2(2.0 * float(p.width) / p.mv_x, 2.0 * float(p.height) / p.mv_y));
				Words(p.motion_out).v[i] = mv;
			}
		}
		Words(p.dst).v[word] = packed;
		return;
	}
	if (at.x >= int(p.width) || at.y >= int(p.height)) return;
	const uint i = uint(at.y) * p.width + uint(at.x);
	if (p.mode == 0u) {
		Floats(p.dst).v[i] = Raw(at);
	} else {
		float m = Mask(at);
		if ((p.flags & 2u) != 0u) {
			for (int y = -1; y <= 1; ++y)
				for (int x = -1; x <= 1; ++x) m = min(m, Mask(at + ivec2(x, y)));
		}
		Floats(p.dst).v[i] = m;
	}
}
